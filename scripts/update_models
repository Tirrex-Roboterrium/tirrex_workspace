#!/bin/bash
set -e
cd "$(dirname -- "${BASH_SOURCE[0]}")/.."

import_gazebo_models() {
    model_archive="$1"
    echo "Import ${model_archive}"
    mkdir -p gazebo/hashes

    nextcloud_download='https://nextcloud.inrae.fr/public.php/dav/files/NPjwMMeFbRPgmEA'
    archive_hash="${model_archive}.sha1"
    remote_hash="/tmp/${archive_hash}"
    local_hash="gazebo/hashes/${archive_hash}"
    archive="/tmp/${model_archive}"

    echo "  download hash (${archive_hash})"
    curl -sLo "${remote_hash}" "${nextcloud_download}/${archive_hash}"

    # check if the hash file is in the correct format
    if grep -qvE '^[0-9a-f]{40}\s+\S+$' "${remote_hash}" ; then
        echo >&2 "Failed to download ${remote_hash}." \
          " The curl request is invalid or the file does not exist."
        exit 1
    fi

    # download archive only if the remote hash differs from the local one
    if [[ ! -r "${local_hash}" ]] || ! cmp -s "${remote_hash}" "${local_hash}" ; then
        echo "  download ${model_archive}"
        curl -Lo "${archive}" "${nextcloud_download}/${model_archive}"
        if tar -C gazebo -xvf "${archive}" ; then
            mv -f "${remote_hash}" "${local_hash}"
        else
            rm "${remote_hash}"
        fi
        rm "${archive}"
    else
        echo "  models are up-to-date"
        rm "${remote_hash}"
    fi
}

import_gazebo_models farm.tar.xz
import_gazebo_models rosconfr26.tar.xz
import_gazebo_models vineyard.tar.xz
